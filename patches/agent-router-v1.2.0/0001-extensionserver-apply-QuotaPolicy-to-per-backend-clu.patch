From 39db029ad21a0cb98f12da5dfdf617ed11fc1885 Mon Sep 17 00:00:00 2001
From: Roi Blum <roiblum05@gmail.com>
Date: Sat, 10 Oct 2026 00:03:05 +0300
Subject: [PATCH 1/2] extensionserver: apply QuotaPolicy to per-backend
 clusters

**Description**

A QuotaPolicy is silently not enforced on an AIGatewayRoute whenever Envoy
Gateway builds one cluster per backend for the generated HTTPRoute. It does
so, for example, when a BackendTrafficPolicy with zone-aware load balancing
(`loadBalancer.zoneAware.weightedZones` or `preferLocal`) targets the
route, and also for destinations with mixed endpoint types or per-backend
filters. The cluster is then named
`httproute/{namespace}/{routeName}/rule/{ruleIndex}/backend/{backendRefIndex}`
and the route points at these clusters.

`resolveClusterRule` only accepted the five-part route-level name. For a
per-backend cluster it returned nil, so `routeHasQuotaBackend` was false
and the route was never patched with the rate limit descriptors: requests
over the quota were answered, nothing was counted, and nothing was logged.

`parseAIGatewayClusterName` already parses both forms. It was added in
#2348 for the cluster modification in `post_translate_modify.go`; the
quota path from #1869 was not updated then. This change makes
`resolveClusterRule` use it too. For a per-backend cluster the returned
rule holds only the backendRef that cluster belongs to. The route-level
helpers go over all clusters of a route, so a route gets the same set of
policies and model name overrides as with the route-level cluster.

The tests cover the name parsing through `backendKeysForCluster` and
`clusterHasQuotaBackend`, and the route level, which is where it failed:
`routeHasQuotaBackend` and `patchRoutesWithQuotaRateLimits` with a route
that points at per-backend clusters. These fail without the change.

Seen with Envoy Gateway v1.9.1 and Envoy AI Gateway v1.1.0: a tenant
limited to 30 tokens per hour got 10 of 10 requests answered and no
counter was written to Redis. With `weightedZones` removed from the
BackendTrafficPolicy and nothing else changed, the same tenant got 5
answers and then 429.

Known limitation, not changed here: the backend index is taken as the
index of the backendRef in the AIGatewayRoute rule, as
`maybeModifyCluster` does. When the controller drops a backendRef that
fails validation from the generated HTTPRoute, the indexes after it shift
and no longer line up. That only happens while the AIGatewayRoute is not
accepted.

Signed-off-by: Roi Blum <roiblum05@gmail.com>
---
 internal/extensionserver/quota_ratelimit.go   |  38 ++---
 .../extensionserver/quota_ratelimit_test.go   | 135 ++++++++++++++++++
 2 files changed, 157 insertions(+), 16 deletions(-)

diff --git a/internal/extensionserver/quota_ratelimit.go b/internal/extensionserver/quota_ratelimit.go
index 6755bc88..78cbdcc7 100644
--- a/internal/extensionserver/quota_ratelimit.go
+++ b/internal/extensionserver/quota_ratelimit.go
@@ -9,8 +9,6 @@ import (
 	"context"
 	"fmt"
 	"sort"
-	"strconv"
-	"strings"
 
 	egv1a1 "github.com/envoyproxy/gateway/api/v1alpha1"
 	clusterv3 "github.com/envoyproxy/go-control-plane/envoy/config/cluster/v3"
@@ -350,34 +348,42 @@ type clusterRouteInfo struct {
 }
 
 // resolveClusterRule parses a cluster name and fetches the corresponding AIGatewayRoute rule.
-// Cluster name format: "httproute/{namespace}/{routeName}/rule/{ruleIndex}"
+//
+// Envoy Gateway names the cluster of a rule "httproute/{namespace}/{routeName}/rule/{ruleIndex}".
+// When it creates one cluster per backend instead, for example because a BackendTrafficPolicy with
+// zone-aware weights targets the route, the name is
+// "httproute/{namespace}/{routeName}/rule/{ruleIndex}/backend/{backendRefIndex}". The returned rule
+// then holds only the backendRef that cluster belongs to.
 func (s *Server) resolveClusterRule(ctx context.Context, clusterName string) *clusterRouteInfo {
-	parts := strings.Split(clusterName, "/")
-	if len(parts) != 5 || parts[0] != "httproute" {
-		return nil
-	}
-	namespace := parts[1]
-	routeName := parts[2]
-	ruleIndex, err := strconv.Atoi(parts[4])
-	if err != nil || ruleIndex < 0 {
+	name, err := parseAIGatewayClusterName(clusterName)
+	if err != nil {
 		return nil
 	}
 
 	var aigwRoute aigv1b1.AIGatewayRoute
 	if err := s.k8sClient.Get(ctx, client.ObjectKey{
-		Namespace: namespace,
-		Name:      routeName,
+		Namespace: name.namespace,
+		Name:      name.routeName,
 	}, &aigwRoute); err != nil {
 		return nil
 	}
 
-	if ruleIndex >= len(aigwRoute.Spec.Rules) {
+	if name.ruleIndex >= len(aigwRoute.Spec.Rules) {
 		return nil
 	}
+	rule := &aigwRoute.Spec.Rules[name.ruleIndex]
+
+	if name.backendRefIndex != noBackendRefIndex {
+		if name.backendRefIndex >= len(rule.BackendRefs) {
+			return nil
+		}
+		rule = rule.DeepCopy()
+		rule.BackendRefs = rule.BackendRefs[name.backendRefIndex : name.backendRefIndex+1]
+	}
 
 	return &clusterRouteInfo{
-		namespace: namespace,
-		rule:      &aigwRoute.Spec.Rules[ruleIndex],
+		namespace: name.namespace,
+		rule:      rule,
 	}
 }
 
diff --git a/internal/extensionserver/quota_ratelimit_test.go b/internal/extensionserver/quota_ratelimit_test.go
